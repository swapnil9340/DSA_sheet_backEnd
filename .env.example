NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
FRONTEND_URL=http://localhost:5173
MONGO_URI=mongodb+srv://chauhan30swapnil_db_user:<db_password>@cluster0.odbh0it.mongodb.net/?appName=Cluster0
JWT_SECRET=replace_this_with_a_random_secret_of_at_least_32_characters
JWT_EXPIRES_IN=7d
AUTH_COOKIE_NAME=dsa_access_token
COOKIE_SAME_SITE=lax
# Set true only behind a correctly configured HTTPS proxy/load balancer.
TRUST_PROXY=false
# Optional. If omitted, API runs without Redis and reads MongoDB directly.
# In a multi-EC2 deployment, point this to a shared Redis endpoint, not localhost on each EC2.
REDIS_URL=
REDIS_TTL_SECONDS=300
LOG_LEVEL=dev
